rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == role;
    }

    function isAdminUser() {
      return hasUserRole("admin");
    }

    function trustedAuthorRole() {
      return isAdminUser() ? "admin" : "user";
    }

    function trustedCoachVerified() {
      return isAdminUser();
    }

    function isString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isNonEmptyString(value, maxLength) {
      return isString(value, maxLength) && value.size() > 0;
    }

    function isNonNegativeInt(value) {
      return value is int && value >= 0;
    }

    function isValidFeedbackCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          "rating",
          "comment",
          "userId",
          "userEmail",
          "timestamp",
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && isString(request.resource.data.comment, 2000)
        && isString(request.resource.data.userEmail, 254)
        && isString(request.resource.data.timestamp, 40);
    }

    function isValidBugReportCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          "description",
          "screen",
          "userId",
          "userEmail",
          "timestamp",
        ])
        && request.resource.data.userId == request.auth.uid
        && isNonEmptyString(request.resource.data.description, 2000)
        && isString(request.resource.data.screen, 300)
        && isString(request.resource.data.userEmail, 254)
        && isString(request.resource.data.timestamp, 40);
    }

    function isValidUserCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "emailVerified",
          "displayName",
          "role",
          "createdAt",
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "user"
        && isString(request.resource.data.email, 254)
        && (!request.resource.data.keys().hasAny(["emailVerified"]) ||
          request.resource.data.emailVerified is bool)
        && isString(request.resource.data.displayName, 60);
    }

    function isValidUserUpdate(userId) {
      return isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email",
          "emailVerified",
          "displayName",
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "email",
        ]) || isString(request.resource.data.email, 254))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "emailVerified",
        ]) || request.resource.data.emailVerified is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "displayName",
        ]) || isString(request.resource.data.displayName, 60));
    }

    function protectedCombatModelFields() {
      return [
        "subscription",
        "subscriptionEndDate",
        "subscriptionStartDate",
        "subscriptionType",
        "stripePriceLookupKey",
        "stripeSubscriptionId",
        "stripeCustomerId",
        "subscriptionStatus",
        "billingProvider",
        "planRegenerationUsage",
      ];
    }

    function isValidCombatModelCreate(userId) {
      return isOwner(userId)
        && (!request.resource.data.keys().hasAny(["subscription"]) ||
          request.resource.data.subscription == false)
        && !request.resource.data.keys().hasAny([
          "stripePriceLookupKey",
          "stripeSubscriptionId",
          "stripeCustomerId",
          "subscriptionStatus",
          "billingProvider",
          "planRegenerationUsage",
        ]);
    }

    function isValidCombatModelUpdate(userId) {
      return isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          protectedCombatModelFields()
        );
    }

    function onlyCounterFieldsChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        "likesCount",
        "savesCount",
        "commentsCount",
        "coachResponseStatus",
        "updatedAt",
      ]);
    }

    function isUnitCounterChange(field) {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny([field])
        || request.resource.data[field] == resource.data[field] + 1
        || request.resource.data[field] == resource.data[field] - 1;
    }

    function isValidCounterUpdate() {
      return request.resource.data.authorId == resource.data.authorId
        && onlyCounterFieldsChanged()
        && isUnitCounterChange("likesCount")
        && isUnitCounterChange("savesCount")
        && isUnitCounterChange("commentsCount")
        && (!request.resource.data.keys().hasAny(["likesCount"]) ||
          isNonNegativeInt(request.resource.data.likesCount))
        && (!request.resource.data.keys().hasAny(["savesCount"]) ||
          isNonNegativeInt(request.resource.data.savesCount))
        && (!request.resource.data.keys().hasAny(["commentsCount"]) ||
          isNonNegativeInt(request.resource.data.commentsCount))
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny([
          "coachResponseStatus",
        ]) || (
          isAdminUser()
          && request.resource.data.coachResponseStatus == "responded"
        ));
    }

    function ownerCoachResponseStatusIsValid() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny([
          "coachResponseStatus",
        ])
        || (
          resource.data.coachResponseStatus != "responded"
          && (
            (
              request.resource.data.coachResponseRequested == true
              && request.resource.data.coachResponseStatus == "requested"
            )
            || (
              request.resource.data.coachResponseRequested == false
              && request.resource.data.coachResponseStatus == "none"
            )
          )
        );
    }

    function hasValidForumCommentDepth() {
      return !request.resource.data.keys().hasAny(["depth"]) || (
        request.resource.data.depth is int &&
        request.resource.data.depth >= 0 &&
        request.resource.data.depth <= 3
      );
    }

    function isValidForumPostCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          "authorId",
          "authorDisplayName",
          "authorAvatarUrl",
          "authorRole",
          "isCoachVerified",
          "title",
          "body",
          "topic",
          "exerciseId",
          "exerciseName",
          "mediaUrl",
          "mediaType",
          "tags",
          "coachResponseRequested",
          "coachResponseStatus",
          "featured",
          "priorityScore",
          "likesCount",
          "savesCount",
          "commentsCount",
          "searchIndex",
          "createdAt",
          "updatedAt",
        ])
        && request.resource.data.authorId == request.auth.uid
        && isString(request.resource.data.authorDisplayName, 60)
        && isString(request.resource.data.authorAvatarUrl, 2048)
        && request.resource.data.authorRole == trustedAuthorRole()
        && request.resource.data.isCoachVerified == trustedCoachVerified()
        && isNonEmptyString(request.resource.data.title, 140)
        && isString(request.resource.data.body, 5000)
        && isString(request.resource.data.topic, 40)
        && isString(request.resource.data.exerciseId, 128)
        && isString(request.resource.data.exerciseName, 80)
        && isString(request.resource.data.mediaUrl, 2048)
        && request.resource.data.mediaType in ["none", "image", "video"]
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        && request.resource.data.coachResponseRequested is bool
        && request.resource.data.coachResponseStatus in [
          "none",
          "requested",
          "responded",
        ]
        && request.resource.data.featured is bool
        && (!request.resource.data.featured || isAdminUser())
        && isNonNegativeInt(request.resource.data.priorityScore)
        && request.resource.data.priorityScore <= 100
        && (request.resource.data.priorityScore == 0 || isAdminUser())
        && request.resource.data.likesCount == 0
        && request.resource.data.savesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.searchIndex is list
        && request.resource.data.searchIndex.size() <= 30;
    }

    function isValidForumPostOwnerUpdate() {
      return request.auth.uid == resource.data.authorId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title",
          "body",
          "topic",
          "exerciseId",
          "exerciseName",
          "mediaUrl",
          "mediaType",
          "tags",
          "coachResponseRequested",
          "coachResponseStatus",
          "searchIndex",
          "updatedAt",
        ])
        && (!request.resource.data.keys().hasAny(["title"]) ||
          isNonEmptyString(request.resource.data.title, 140))
        && (!request.resource.data.keys().hasAny(["body"]) ||
          isString(request.resource.data.body, 5000))
        && (!request.resource.data.keys().hasAny(["topic"]) ||
          isString(request.resource.data.topic, 40))
        && (!request.resource.data.keys().hasAny(["exerciseId"]) ||
          isString(request.resource.data.exerciseId, 128))
        && (!request.resource.data.keys().hasAny(["exerciseName"]) ||
          isString(request.resource.data.exerciseName, 80))
        && (!request.resource.data.keys().hasAny(["mediaUrl"]) ||
          isString(request.resource.data.mediaUrl, 2048))
        && (!request.resource.data.keys().hasAny(["mediaType"]) ||
          request.resource.data.mediaType in ["none", "image", "video"])
        && (!request.resource.data.keys().hasAny(["tags"]) ||
          (request.resource.data.tags is list &&
            request.resource.data.tags.size() <= 5))
        && (!request.resource.data.keys().hasAny(["coachResponseRequested"]) ||
          request.resource.data.coachResponseRequested is bool)
        && (!request.resource.data.keys().hasAny(["coachResponseStatus"]) ||
          request.resource.data.coachResponseStatus in [
            "none",
            "requested",
          ])
        && ownerCoachResponseStatusIsValid()
        && (!request.resource.data.keys().hasAny(["searchIndex"]) ||
          (request.resource.data.searchIndex is list &&
            request.resource.data.searchIndex.size() <= 30));
    }

    function forumPostExists(postId) {
      return exists(/databases/$(database)/documents/forumPosts/$(postId));
    }

    function isForumCommentCreate(postId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          "authorId",
          "authorDisplayName",
          "authorAvatarUrl",
          "authorRole",
          "isCoachVerified",
          "body",
          "postId",
          "parentCommentId",
          "rootCommentId",
          "depth",
          "createdAt",
          "updatedAt",
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.postId == postId
        && isString(request.resource.data.authorDisplayName, 60)
        && isString(request.resource.data.authorAvatarUrl, 2048)
        && request.resource.data.authorRole == trustedAuthorRole()
        && request.resource.data.isCoachVerified == trustedCoachVerified()
        && isNonEmptyString(request.resource.data.body, 2000)
        && isString(request.resource.data.parentCommentId, 128)
        && isString(request.resource.data.rootCommentId, 128)
        && hasValidForumCommentDepth();
    }

    function isValidForumCommentUpdate() {
      return isSignedIn()
        && request.auth.uid == resource.data.authorId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "body",
          "updatedAt",
        ])
        && isNonEmptyString(request.resource.data.body, 2000);
    }

    match /combatModel/{userId} {
      allow read: if isOwner(userId);
      allow create: if isValidCombatModelCreate(userId);
      allow update: if isValidCombatModelUpdate(userId);
      allow delete: if false;
    }

    match /users/{userId} {
      allow create: if isValidUserCreate(userId);
      allow read: if isOwner(userId);
      allow update: if isValidUserUpdate(userId);
      allow delete: if false;
    }

    match /feedbacks/{feedbackId} {
      allow create: if isValidFeedbackCreate();
      allow read, update, delete: if false;
    }

    match /bugReports/{bugReportId} {
      allow create: if isValidBugReportCreate();
      allow read, update, delete: if false;
    }

    match /forumPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isValidForumPostCreate();
      allow update: if isSignedIn() && (
        isValidForumPostOwnerUpdate() ||
        isValidCounterUpdate()
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;

      match /comments/{commentId} {
        allow read: if isSignedIn() && forumPostExists(postId);
        allow create: if isForumCommentCreate(postId);
        allow update: if isValidForumCommentUpdate();
        allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;

        match /{replyPath=**} {
          allow read: if isSignedIn() && forumPostExists(postId);
          allow create: if isForumCommentCreate(postId);
          allow update: if isValidForumCommentUpdate();
          allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;
        }
      }
    }
  }
}
