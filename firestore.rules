rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function onlyCounterFieldsChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        "likesCount",
        "savesCount",
        "commentsCount",
        "coachResponseStatus",
        "updatedAt",
      ]);
    }

    match /combatModel/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid;
      allow read, update: if isOwner(userId);
      allow delete: if false;
    }

    match /feedbacks/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /forumPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.authorId ||
        (
          request.resource.data.authorId == resource.data.authorId &&
          onlyCounterFieldsChanged()
        )
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.postId == postId;
        allow update, delete: if isSignedIn()
          && request.auth.uid == resource.data.authorId;
      }
    }
  }
}
