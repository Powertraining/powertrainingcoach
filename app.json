{
  "expo": {
    "name": "Power Training Coach",
    "slug": "power-training-coach",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "26b5ffd7-cc77-4e3d-abf9-df6edb98c301"
      }
    },
    "icon": "./src/assets/app-icon-black-gradient.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/login-bg.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.powertraining.coach",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app-icon-black-gradient.png",
        "backgroundColor": "#000000"
      },
      "package": "com.powertraining.coach",
      "googleServicesFile": "./google-services.json"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "scheme": "powertrainingcoach",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Power Training Coach to choose profile photos and forum media from your library."
        }
      ],
      "expo-video",
      "expo-web-browser"
    ],
    "owner": "power-training"
  }
}
