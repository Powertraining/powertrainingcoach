{
  "expo": {
    "name": "PowerTrainingCoach",
    "slug": "powertrainingcoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "extra": {
      "router": {
        "origin": false
      }
    },
    "icon": "./app/assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./app/assets/login-bg.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.powertraining.coach"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.powertraining.coach",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./app/assets/logo.png",
      "bundler": "metro"
    },
    "scheme": "powertrainingcoach",
    "experiments": {
      "typedRoutes": true
    }
  }
}
