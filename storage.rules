rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to base training plans for authenticated users.
    match /baseTrainingPlans/{planPath=**} {
      allow read: if request.auth != null;
    }

    // Allow read access to live prompt instructions and reference images.
    match /instructions/{instructionPath=**} {
      allow read: if request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isImageUpload(maxSize) {
      return request.resource != null
        && request.resource.size < maxSize
        && request.resource.contentType.matches("image/.*");
    }

    function isForumMediaUpload() {
      return request.resource != null
        && request.resource.size < 100 * 1024 * 1024
        && (
          request.resource.contentType.matches("image/.*") ||
          request.resource.contentType.matches("video/.*")
        );
    }

    match /profilePictures/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) && isImageUpload(10 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /forumMedia/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) && isForumMediaUpload();
      allow delete: if isOwner(userId);
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
